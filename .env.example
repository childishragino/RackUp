# Public — safe to expose in the client bundle (Supabase anon key is RLS-protected).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only — used by /api/health-import (Vercel function). Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
